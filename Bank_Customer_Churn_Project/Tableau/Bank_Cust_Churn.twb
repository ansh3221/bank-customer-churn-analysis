        </column>
        <column caption='Age Group' datatype='string' name='[Calculation_2695230806921219]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [Age] &lt; 30 THEN &quot;18-29&quot;&#13;&#10;ELSEIF [Age] &lt; 40 THEN &quot;30-39&quot;&#13;&#10;ELSEIF [Age] &lt; 50 THEN &quot;40-49&quot;&#13;&#10;ELSEIF [Age] &lt; 60 THEN &quot;50-59&quot;&#13;&#10;ELSE &quot;60+&quot;&#13;&#10;END' />
        </column>
        <column caption='Credit Score Group' datatype='string' name='[Calculation_2695230808870916]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [CreditScore] &lt; 500 THEN &quot;Below 500&quot;&#13;&#10;ELSEIF [CreditScore] &lt; 600 THEN &quot;500-599&quot;&#13;&#10;ELSEIF [CreditScore] &lt; 700 THEN &quot;600-699&quot;&#13;&#10;ELSEIF [CreditScore] &lt; 800 THEN &quot;700-799&quot;&#13;&#10;ELSE &quot;800+&quot;&#13;&#10;END' />
        </column>
