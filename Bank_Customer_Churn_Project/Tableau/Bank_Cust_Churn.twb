      <aliases enabled='yes' />
      <column caption='Balance (bin)' datatype='integer' name='[Balance (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='4' formula='[Balance]' peg='0' size='25000' />
      </column>
      <column datatype='real' name='[Balance]' role='measure' type='quantitative' />
      <column caption='churn rate' datatype='real' name='[Calculation_2695230800695296]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Exited]) / COUNTD([CustomerId])' />
      </column>
      <column caption='Churn Status' datatype='string' name='[Calculation_2695230802886657]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Exited] = 1 THEN &quot;Churned&quot;&#13;&#10;ELSE &quot;Retained&quot;&#13;&#10;END' />
      </column>
      <column caption='Member Status' datatype='string' name='[Calculation_2695230805340162]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [IsActiveMember] = 1 THEN &quot;Active&quot;&#13;&#10;ELSE &quot;Inactive&quot;&#13;&#10;END' />
      </column>
      <column caption='Age Group' datatype='string' name='[Calculation_2695230806921219]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Age] &lt; 30 THEN &quot;18-29&quot;&#13;&#10;ELSEIF [Age] &lt; 40 THEN &quot;30-39&quot;&#13;&#10;ELSEIF [Age] &lt; 50 THEN &quot;40-49&quot;&#13;&#10;ELSEIF [Age] &lt; 60 THEN &quot;50-59&quot;&#13;&#10;ELSE &quot;60+&quot;&#13;&#10;END' />
      </column>
      <column caption='Credit Score Group' datatype='string' name='[Calculation_2695230808870916]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [CreditScore] &lt; 500 THEN &quot;Below 500&quot;&#13;&#10;ELSEIF [CreditScore] &lt; 600 THEN &quot;500-599&quot;&#13;&#10;ELSEIF [CreditScore] &lt; 700 THEN &quot;600-699&quot;&#13;&#10;ELSEIF [CreditScore] &lt; 800 THEN &quot;700-799&quot;&#13;&#10;ELSE &quot;800+&quot;&#13;&#10;END' />
      </column>
      <column caption='Credit Card Status' datatype='string' name='[Calculation_2695231150596101]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [HasCrCard] = 1 THEN &quot;Has Credit Card&quot;&#13;&#10;ELSE &quot;No Credit Card&quot;&#13;&#10;END' />
      </column>
      <column caption='Calculated Field' datatype='integer' name='[Calculation_2695231331291142]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Exited] = 1 THEN [CustomerId] END&#13;&#10;)' />
      </column>
      <column caption='Churn Probability' datatype='real' name='[ChurnProbability]' role='measure' type='quantitative' />
      <column caption='Credit Score' datatype='integer' name='[CreditScore]' role='measure' type='quantitative' />
      <column caption='Customer Id' datatype='integer' name='[CustomerId]' role='dimension' type='ordinal' />
      <column caption='Estimated Salary (bin)' datatype='integer' name='[Estimated Salary (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='4' formula='[EstimatedSalary]' peg='0' size='25000' />
      </column>
      <column caption='Estimated Salary' datatype='real' name='[EstimatedSalary]' role='measure' type='quantitative' />
      <column caption='Has Cr Card' datatype='integer' name='[HasCrCard]' role='measure' type='quantitative' />
      <column caption='Is Active Member' datatype='integer' name='[IsActiveMember]' role='measure' type='quantitative' />
